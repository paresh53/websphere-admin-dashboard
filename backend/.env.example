# ============================================================
#  Environment variables required by the dashboard backend.
#  Copy this file to .env and fill in actual values.
#  NEVER commit the real .env file to version control.
# ============================================================

# --- WebSphere Deployment Manager ---
DMGR_PASSWORD=changeme

# --- SSH private key path (used for all WAS nodes by default) ---
WAS_SSH_KEY_PATH=C:/Users/yourusername/.ssh/id_rsa

# --- IIS server passwords (one per IIS server if different) ---
IIS1_PASSWORD=changeme
IIS2_PASSWORD=changeme
IIS_DR_PASSWORD=changeme

# --- Optional: protect the dashboard UI with basic-auth ---
DASHBOARD_PASSWORD=changeme

# --- Optional: override backend port (default 8000) ---
# BACKEND_PORT=8000
